# ==============================================================================
# OCR Correction Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your API credentials.
# CLI arguments take precedence over these values.

# ------------------------------------------------------------------------------
# 1. Active Provider Selection
# ------------------------------------------------------------------------------
# Default provider when running non-interactively ('deepseek' or 'freemodel')
DEFAULT_API_PROVIDER=deepseek

# ------------------------------------------------------------------------------
# 2. DeepSeek Provider Settings
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ------------------------------------------------------------------------------
# 3. FreeModel / Custom OpenAI-Compatible Provider Settings
# ------------------------------------------------------------------------------
FREEMODEL_API_KEY=your_freemodel_api_key_here
FREEMODEL_BASE_URL=https://api.freemodel.dev/v1
FREEMODEL_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 4. Pipeline Concurrency & Chunking Configuration
# ------------------------------------------------------------------------------
# Number of parallel worker threads for API calls
MAX_WORKERS=5

# Target character count per semantic chunk (recommended: 1000 - 1500)
MAX_CHUNK_CHARS=1500

# Hard upper ceiling per chunk (larger segments will be force-split)
HARD_CHAR_LIMIT=2000

# Maximum token limit requested per API completion
MAX_OUTPUT_TOKENS=8192

# Multiplier headroom for expected Devanagari output token ratio
OUTPUT_HEADROOM=2.0

# ------------------------------------------------------------------------------
# 5. Paths & Logging
# ------------------------------------------------------------------------------
# Directory containing source .docx documents to process
INPUT_DIR=data

# Directory where corrected .docx documents will be saved
OUTPUT_DIR=output

# Log filenames
ERROR_LOG_PATH=error_logs.txt
CULPRIT_LOG_PATH=skipped_culprits.txt